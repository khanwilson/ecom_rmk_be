# Dependencies (match at any level) - CRITICAL: Exclude node_modules
**/node_modules
**/npm-debug.log
**/yarn-error.log
# yarn.lock is needed for frozen-lockfile install, so we need to copy it
# **/yarn.lock

# Build outputs (match at any level)
**/dist
**/generated
**/*.tsbuildinfo

# Environment & secrets (match at any level: root, product/, identity/, etc.)
**/.env
**/.env.*

# Git (match at any level)
**/.git
**/.gitignore

# Docker files (match at any level)
**/Dockerfile
**/Dockerfile.*
**/.dockerignore
**/docker-compose*.yml

# IDE files (match at any level)
**/.vscode
**/.idea
**/*.swp
**/*.swo

# Testing (match at any level)
**/coverage
**/.nyc_output
**/*.spec.ts
**/*.test.ts

# Misc (match at any level)
**/*.md
**/.DS_Store
**/Thumbs.db
**/*.log
