# Development Dockerfile for Identity Service
# Use official Bun image (see all versions at https://hub.docker.com/r/oven/bun/tags)
FROM oven/bun:1

# Destination path of COPY and WORKDIR
WORKDIR /usr/src/identity

# Install dependencies for Prisma
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Copy libs source code and build package
COPY libs/ /usr/src/libs/
WORKDIR /usr/src/libs
RUN bun install && bun pack:publish

# Return to service directory and copy package files
WORKDIR /usr/src/identity
# Copy all service files
COPY identity/ ./
# Copy and set up entrypoint script
COPY identity/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set entrypoint to handle bun install and prisma generate
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Push schema to database and start dev server
CMD ["sh", "-c", "bunx prisma db push && bun run start:dev"]
