{
  "name": "@ecom-rmk/libs",
  "version": "1.0.0",
  "description": "Shared libraries for ecom-rmk microservices",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./redis/index.ts",
      "require": "./dist/redis/index.js",
      "import": "./dist/redis/index.js"
    },
    "./common": {
      "types": "./common/index.ts",
      "require": "./dist/common/index.js",
      "import": "./dist/common/index.js"
    },
    "./kafka": {
      "types": "./kafka/index.ts",
      "require": "./dist/kafka/index.js",
      "import": "./dist/kafka/index.js"
    },
    "./utils": {
      "types": "./utils/index.ts",
      "require": "./dist/utils/index.js",
      "import": "./dist/utils/index.js"
    },
    "./auth": {
      "types": "./auth/index.ts",
      "require": "./dist/auth/index.js",
      "import": "./dist/auth/index.js"
    }
  },
  "files": [
    "*.ts",
    "**/*.ts",
    "!**/*.spec.ts",
    "!**/*.test.ts",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-org>/ecom-rmk-be.git",
    "directory": "libs"
  },
  "keywords": [
    "nestjs",
    "microservices",
    "shared",
    "libs",
    "redis",
    "utils"
  ],
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "pack:publish": "bun run build && bun pm pack",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^8.1.1",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.12.33",
    "mongodb": "^6.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.1.0"
  }
}
