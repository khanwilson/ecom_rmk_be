generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_PRODUCT")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  DELETED
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  sku         String        @unique
  price       Float
  status      ProductStatus @default(DRAFT)
  type        ProductType   @default(PHYSICAL)
  stock       Int           @default(0)
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@map("Product")
}

