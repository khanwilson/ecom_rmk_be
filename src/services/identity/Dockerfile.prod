# Dockerfile for Identity Service
FROM node:24-alpine
WORKDIR /usr/src/services/identity

# Copy package files
COPY package.json yarn.lock* ./

# Install dependencies
RUN yarn install --frozen-lockfile \
  && yarn cache clean

# Copy Prisma schema and config (prisma.config.ts is inside prisma/ directory)
COPY prisma ./prisma

# Generate Prisma Client (using ARG passed from docker-compose)
ARG DB_URI
ENV DB_URI=${DB_URI}
RUN npx prisma generate --config=prisma/prisma.config.ts

# Copy source code (excludes files in .dockerignore)
# .dockerignore will prevent .env, Dockerfile, docker-compose files from being copied
COPY . .

# Build application
RUN yarn build

# Run production
CMD ["yarn", "start:prod"]

